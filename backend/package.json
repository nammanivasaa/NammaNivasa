{
  "name": "namma-nivasa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "AUTH_MODE=test tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
